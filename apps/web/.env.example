# Gapture Web App — environment
#
# PLACEHOLDERS ONLY. Copy to `apps/web/.env.local` (gitignored) and fill in.
# For Vercel, set these in the project's Environment Variables settings.

# --- Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never referenced in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL — only for running migrations (supabase db push).
# Use the IPv4 pooler host, not db.<ref>.supabase.co (IPv6-only).
SUPABASE_DB_URL=

# --- AI / retrieval (server-only) ------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_ANALYSIS_MODEL=gpt-5-mini

PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=gaptureai
PINECONE_NAMESPACE_REGULATORY=regulatory
PINECONE_NAMESPACE_POLICY=policy

# --- OCR (server-only) ---------------------------------------------
OCR_SPACE_API_KEY=
OCR_REQUEST_TIMEOUT_MS=30000

# --- Crypto (server-only) ----------------------------------------
# Same value as the worker — AES key for policy originals at rest.
DOCUMENT_ENCRYPTION_KEY=

# --- Voice (Phase 14, server-only) -------------------------------
ELEVENLABS_API_KEY=
