# Gapture Monitoring Worker — environment
#
# PLACEHOLDERS ONLY. Copy to `worker/.env` (gitignored) and fill real values.
# The worker is a standalone Node process — it does NOT read apps/web/.env.local.

# Supabase — worker uses the service role (bypasses RLS) for privileged writes.
# No NEXT_PUBLIC_ prefix needed here; this is not a Next.js app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Monitoring loop interval in milliseconds. No source document specifies a
# target; 300000 (5 min) is a reasonable default (Architecture Decision).
WORKER_POLL_INTERVAL_MS=300000

# Per-request timeout when fetching a source feed/page.
SOURCE_FETCH_TIMEOUT_MS=30000

# OCR.space — the ONLY OCR provider (docs/IMPLEMENTATION-PLAN.md §8.3).
OCR_SPACE_API_KEY=
OCR_REQUEST_TIMEOUT_MS=30000

# AES-256 key for encrypting stored original documents. Any length — it is
# run through SHA-256 to derive the 32-byte key.
DOCUMENT_ENCRYPTION_KEY=

# Largest original file the worker will retrieve and store (bytes).
MAX_DOCUMENT_BYTES=26214400

# DETECTED-backlog documents processed per cycle (bounds OCR.space calls).
INGESTION_BATCH_SIZE=5

# STORED documents cleaned + chunked per cycle (Phase 6 — pure CPU, no API limit).
CLEANING_BATCH_SIZE=10

# --- Phase 7: Embeddings & Pinecone ---------------------------------------
# OpenAI Embeddings (HLSA AD-09). Server-only key.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# MUST equal the Pinecone index dimension. The gaptureai index is 1024;
# text-embedding-3-small emits 1024 natively via the `dimensions` param.
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_REQUEST_TIMEOUT_MS=30000

# Pinecone data plane. INDEX_HOST is the full https host from the Pinecone
# console (not the control-plane api.pinecone.io).
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_REQUEST_TIMEOUT_MS=30000
PINECONE_NAMESPACE_REGULATORY=regulatory
PINECONE_NAMESPACE_POLICY=policy

# INDEXING documents embedded + upserted to Pinecone per cycle.
EMBEDDING_BATCH_SIZE=5

# --- Phase 8: Compliance policy processing --------------------------------
# Uploaded/in-flight policies processed per cycle (extract -> clean -> chunk
# -> embed). Small: each may make an OCR call. Uses the same OpenAI/Pinecone
# config above; policy vectors go to the PINECONE_NAMESPACE_POLICY namespace.
POLICY_BATCH_SIZE=3

# --- Phase 9: NLP / AI analysis ------------------------------------------
# Chat model for the regulatory-vs-policy comparison (gpt-5 family; must
# support response_format json_schema). Pick the cheapest that meets quality.
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_ANALYSIS_MAX_TOKENS=4000
OPENAI_ANALYSIS_TIMEOUT_MS=60000
# ANALYZING documents analysed per cycle — one LLM call per (document x org).
ANALYSIS_BATCH_SIZE=3
# Policy chunks pulled from Pinecone as grounding context, per org.
ANALYSIS_CONTEXT_TOPK=8
# Max characters of regulatory text placed in the analysis prompt.
ANALYSIS_MAX_REG_CHARS=12000

# --- Phase 11: Notifications --------------------------------------------
# Recently-COMPLETED documents checked for missing notifications per cycle
# (cheap DB-only fan-out; check-then-insert, idempotent).
NOTIFICATION_BATCH_SIZE=10

NODE_ENV=development
