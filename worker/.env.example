# Gapture Monitoring Worker — environment
#
# PLACEHOLDERS ONLY. Copy to `worker/.env` (gitignored) and fill real values.
# The worker is a standalone Node process — it does NOT read apps/web/.env.local.

# Supabase — worker uses the service role (bypasses RLS) for privileged writes.
# No NEXT_PUBLIC_ prefix needed here; this is not a Next.js app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Monitoring loop interval in milliseconds. No source document specifies a
# target; 300000 (5 min) is a reasonable default (Architecture Decision).
WORKER_POLL_INTERVAL_MS=300000

# Per-request timeout when fetching a source feed/page.
SOURCE_FETCH_TIMEOUT_MS=30000

# OCR.space — the ONLY OCR provider (docs/IMPLEMENTATION-PLAN.md §8.3).
OCR_SPACE_API_KEY=
OCR_REQUEST_TIMEOUT_MS=30000

# AES-256 key for encrypting stored original documents. Any length — it is
# run through SHA-256 to derive the 32-byte key.
DOCUMENT_ENCRYPTION_KEY=

# Largest original file the worker will retrieve and store (bytes).
MAX_DOCUMENT_BYTES=26214400

# DETECTED-backlog documents processed per cycle (bounds OCR.space calls).
INGESTION_BATCH_SIZE=5

# STORED documents cleaned + chunked per cycle (Phase 6 — pure CPU, no API limit).
CLEANING_BATCH_SIZE=10

NODE_ENV=development
