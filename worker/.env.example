# Gapture Monitoring Worker — environment
#
# PLACEHOLDERS ONLY. Copy to `worker/.env` (gitignored) and fill real values.
# The worker is a standalone Node process — it does NOT read apps/web/.env.local.

# Supabase — worker uses the service role (bypasses RLS) for privileged writes.
# No NEXT_PUBLIC_ prefix needed here; this is not a Next.js app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Monitoring loop interval in milliseconds. No source document specifies a
# target; 300000 (5 min) is a reasonable default (Architecture Decision).
WORKER_POLL_INTERVAL_MS=300000

# Per-request timeout when fetching a source feed/page.
SOURCE_FETCH_TIMEOUT_MS=30000

NODE_ENV=development
