# Gapture FT-07 — Environment Variables
#
# PLACEHOLDERS ONLY. This file is committed to git — never put a real value
# in it. Copy it to `apps/web/.env.local` and `worker/.env` and fill in real
# values THERE (both are gitignored).
#
# Naming: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY need the
# NEXT_PUBLIC_ prefix because Next.js only inlines prefixed vars into the
# browser bundle — without it, client-side Supabase Auth calls (sign-in,
# sign-up, OAuth) silently can't read them. Everything else is server-only.
# See docs/IMPLEMENTATION-PLAN.md §36/§8.4 for the full naming history.

# --- Frontend-safe (NEXT_PUBLIC_* — safe to expose to the browser) ---------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets — never prefix with NEXT_PUBLIC_, never log these -
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection — only needed for running migrations (the app
# itself talks to Supabase via the REST/Auth API, never raw Postgres).
# Use the CONNECTION POOLER string from Supabase's "Connect" dialog, not the
# direct db.<ref>.supabase.co one — the latter is IPv6-only on many projects
# and will fail to resolve from IPv4-only networks/CI runners.
SUPABASE_DB_URL=

OPENAI_API_KEY=

# Pinecone needs BOTH an API key (secret) and the index host URL (not
# secret, but specific to your index) — they are two different values.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_INDEX_NAME=

ELEVENLABS_API_KEY=

# OCR.space — the ONLY OCR provider (docs/IMPLEMENTATION-PLAN.md §8.3).
# Endpoint is fixed (https://api.ocr.space/parse/image) and hardcoded in
# packages/shared/src/services/ocr — only the key is configurable here.
OCR_SPACE_API_KEY=
OCR_REQUEST_TIMEOUT_MS=30000

# Document encryption (AES-256) — MVP: a single server-side symmetric key.
DOCUMENT_ENCRYPTION_KEY=

# --- Worker-only ------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=300000
RBI_RSS_FEED_URL=
SEBI_RSS_FEED_URL=

# --- Standard ---------------------------------------------------------------
NODE_ENV=development
