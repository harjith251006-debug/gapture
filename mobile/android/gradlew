# Standard Gradle wrapper launcher. Requires gradle/wrapper/gradle-wrapper.jar
# (generated by Android Studio on first sync, or by running `gradle wrapper`).

APP_HOME=$(cd "$(dirname "$0")" && pwd)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$CLASSPATH" ]; then
  echo "gradle-wrapper.jar is missing. Open this project in Android Studio once," >&2
  echo "or run 'gradle wrapper' with a system Gradle, to generate it." >&2
  exit 1
fi

JAVACMD="${JAVA_HOME:+$JAVA_HOME/bin/}java"
exec "$JAVACMD" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
